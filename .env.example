# ════════════════════════════════════════════════════════════════════
# IMSE EASY EMS — environment variables
# ────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env` to Git.
# ════════════════════════════════════════════════════════════════════

# ── Postgres (local dev only — Cloud SQL uses its own creds) ─────
POSTGRES_USER=ems
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ems

# ── Database URL (used by Prisma) ────────────────────────────────
# Local dev (inside docker compose):
DATABASE_URL=postgresql://ems:change-me-locally@db:5432/ems?schema=public
# Cloud Run (via Cloud SQL Auth Proxy — see docs/cloud-run-setup.md):
# DATABASE_URL=postgresql://ems:REDACTED@localhost/ems?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public

# ── Google OAuth ─────────────────────────────────────────────────
# The SAME client ID used in index.html and field_app.html.
# Currently: 807569986194-feca4li2k0t96tbbutlpu2ko64obe95k.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=807569986194-feca4li2k0t96tbbutlpu2ko64obe95k.apps.googleusercontent.com

# ── Google Workspace domain restriction (recommended) ────────────
# Only accept sign-ins from *@imse.org.in. Leave empty to allow any Google account.
GOOGLE_WORKSPACE_DOMAIN=imse.org.in

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to hit /api/*.
# Add https://easwaranps.github.io for GitHub Pages hosting.
CORS_ORIGIN=http://localhost:8080,https://easwaranps.github.io

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
